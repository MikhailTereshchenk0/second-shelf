# LOCAL DEVELOPMENT ONLY.
# This file intentionally contains demo credentials and insecure defaults for the `local` Spring profile.
# Never reuse these values in staging, production, or any shared environment.
# For docker-compose, container hostnames and some inter-service URLs are overridden in docker-compose.yaml.
# DB_HOST, RABBITMQ_HOST, USER_SERVICE_BASE_URL, and BOOK_SERVICE_BASE_URL below are primarily useful when
# you run services directly from the IDE or terminal outside docker-compose.
# Some optional reliability variables below are supported by the service configuration, but the current
# docker-compose stack relies on the same service defaults unless those variables are forwarded explicitly.

# ===== shared =====
# Demo values below are allowed only for the `local` profile.
INTERNAL_TOKEN=internal-secret-123
JWT_SECRET=change_this_secret_to_something_long_and_random_1234567890_change_me
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000
# Optional for local profile. Required with a strong value outside `local`.
AUTH_REFRESH_TOKEN_PEPPER=replace_me_with_a_long_random_secret_for_non_local_runs

# ===== postgres =====
POSTGRES_USER=second_shelf
# Demo password for local profile only.
POSTGRES_PASSWORD=secret
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ===== rabbitmq =====
# RABBITMQ_PORT is used by services when they connect to a broker directly outside docker-compose.
# RABBITMQ_HOST_PORT is only the host-mapped port published by docker-compose.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_HOST_PORT=5672
# Demo credentials for local profile only.
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ===== rabbitmq topology =====
# Shared event topology for exchange-service -> notification-service.
EXCHANGE_EVENTS_EXCHANGE=exchange.events
EXCHANGE_EVENTS_QUEUE=notification.exchange-events
EXCHANGE_EVENTS_ROUTING_KEY_PATTERN=exchange.request.*
# If you keep these values unchanged, they match the defaults derived in code.
EXCHANGE_EVENTS_DLQ_EXCHANGE=notification.exchange-events.dlx
EXCHANGE_EVENTS_DLQ_QUEUE=notification.exchange-events.dlq
EXCHANGE_EVENTS_DLQ_ROUTING_KEY=notification.exchange-events.dlq

# ===== db connection =====
DB_HOST=localhost
DB_USERNAME=second_shelf
# Demo password for local profile only.
DB_PASSWORD=secret
USER_DB_NAME=users_db
AUTH_DB_NAME=auth_db
BOOK_DB_NAME=books_db
EXCHANGE_DB_NAME=exchange_db
NOTIFICATION_DB_NAME=notification_db

# ===== service ports =====
API_GATEWAY_PORT=8088
AUTH_SERVICE_PORT=8080
USER_SERVICE_PORT=8081
BOOK_SERVICE_PORT=8082
EXCHANGE_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084

# ===== frontend / gateway =====
FRONTEND_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== inter-service urls =====
USER_SERVICE_BASE_URL=http://localhost:8081
BOOK_SERVICE_BASE_URL=http://localhost:8082

# Used by api-gateway when you run services directly from the IDE or terminal outside docker-compose.
AUTH_SERVICE_URI=http://localhost:8080
USER_SERVICE_URI=http://localhost:8081
BOOK_SERVICE_URI=http://localhost:8082
EXCHANGE_SERVICE_URI=http://localhost:8083
NOTIFICATION_SERVICE_URI=http://localhost:8084

# ===== exchange outbox publisher =====
# Supported by exchange-service. The current docker-compose stack works with these defaults.
EXCHANGE_OUTBOX_PUBLISHER_ENABLED=true
EXCHANGE_OUTBOX_PUBLISHER_FIXED_DELAY_MS=5000
EXCHANGE_OUTBOX_PUBLISHER_CONFIRM_TIMEOUT_MS=10000
EXCHANGE_OUTBOX_PUBLISHER_MAX_ATTEMPTS=5

# ===== seed admin =====
# user-service creates this admin on startup if a user with the same username does not exist yet.
# These demo values are for local profile only.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_EMAIL=admin@secondshelf.local
