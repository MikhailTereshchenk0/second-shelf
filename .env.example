# FOR EXAMPLE ONLY!!!

# ===== shared =====
INTERNAL_TOKEN=internal-secret-123
JWT_SECRET=change_this_secret_to_something_long_and_random_1234567890_change_me

# ====== postgres (container) ======
POSTGRES_USER=second_shelf
POSTGRES_PASSWORD=secret
POSTGRES_DB=users_db
POSTGRES_PORT=5432

# ====== DB connection for services (host-side) ======
DB_HOST=localhost
DB_USERNAME=second_shelf
DB_PASSWORD=secret
USERS_DB_NAME=users_db
AUTH_DB_NAME=auth_db
BOOKS_DB_NAME=books_db
EXCHANGE_DB_NAME=exchange_db

# ====== service ports ======
USER_SERVICE_PORT=8081
AUTH_SERVICE_PORT=8080
BOOK_SERVICE_PORT=8082
EXCHANGE_SERVICE_PORT=8083

# ====== inter-service url ======
USER_SERVICE_BASE_URL=http://localhost:8081
BOOK_SERVICE_BASE_URL=http://localhost:8082

# ====== jwt expiration ======
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# ====== seed admin ======
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_EMAIL=admin@secondshelf.local