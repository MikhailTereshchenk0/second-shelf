# PRODUCTION-LIKE PLACEHOLDERS ONLY.
# Do not commit real values. Copy this file outside version control or export
# equivalent environment variables before using docker-compose.prod.example.yaml.

# ===== gateway =====
PROD_API_GATEWAY_PORT=<external-gateway-port>
PROD_FRONTEND_ALLOWED_ORIGINS=<https://frontend.example.com>

# ===== shared secrets =====
PROD_INTERNAL_TOKEN=<strong-internal-service-token>
PROD_JWT_SECRET=<strong-jwt-signing-secret>
PROD_AUTH_REFRESH_TOKEN_PEPPER=<strong-refresh-token-pepper>

# ===== token lifetimes =====
PROD_JWT_ACCESS_EXPIRATION_MS=<access-token-ttl-ms>
PROD_JWT_REFRESH_EXPIRATION_MS=<refresh-token-ttl-ms>

# ===== postgres bootstrap =====
PROD_POSTGRES_USER=<postgres-bootstrap-user>
PROD_POSTGRES_PASSWORD=<postgres-bootstrap-password>
PROD_POSTGRES_DB=<postgres-bootstrap-database>

# ===== seed admin =====
PROD_SEED_ADMIN_USERNAME=<seed-admin-username>
PROD_SEED_ADMIN_EMAIL=<seed-admin-email>
PROD_SEED_ADMIN_PASSWORD=<seed-admin-password>

# ===== rabbitmq =====
PROD_RABBITMQ_USERNAME=<rabbitmq-user>
PROD_RABBITMQ_PASSWORD=<rabbitmq-password>

# ===== rabbitmq topology =====
PROD_EXCHANGE_EVENTS_EXCHANGE=<exchange-events-topic-name>
PROD_EXCHANGE_EVENTS_QUEUE=<notification-events-queue-name>
PROD_EXCHANGE_EVENTS_ROUTING_KEY_PATTERN=<exchange-events-routing-pattern>
PROD_EXCHANGE_EVENTS_DLQ_EXCHANGE=<dead-letter-exchange-name>
PROD_EXCHANGE_EVENTS_DLQ_QUEUE=<dead-letter-queue-name>
PROD_EXCHANGE_EVENTS_DLQ_ROUTING_KEY=<dead-letter-routing-key>
